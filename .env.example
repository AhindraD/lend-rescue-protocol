# LendRescue Monorepo Environment Configuration Baseline
# Copy to apps/api/.env or configure in deployment environments

# API Server Settings
BIND_HOST=127.0.0.1
BIND_PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT_SECS=30
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Telemetry & History (Optional; falls back to in-memory store)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lend_rescue

# Solana Cluster & RPC (Phase 5D)
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=surfpool
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# SURFPOOL_RPC_URL=http://127.0.0.1:8899

# Oracle Configuration (Phase 5A)
ORACLE_SOURCE=demo
PYTH_PROGRAM_ID=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
PYTH_MAX_AGE_SECS=60
PYTH_MAX_CONFIDENCE_RATIO_BPS=200
PYTH_REQUEST_TIMEOUT_MS=5000
HERMES_URL=https://hermes.pyth.network
# PYTH_API_KEY=your_pyth_api_key_here

# Kamino Lending Adapter Configuration (Phase 5B & 5D)
POSITION_SOURCE=demo
KAMINO_ADAPTER_BIND_HOST=127.0.0.1
KAMINO_ADAPTER_BIND_PORT=3002
KAMINO_ADAPTER_URL=http://127.0.0.1:3002
KAMINO_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD
KAMINO_MARKET_ADDRESS=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF
# KAMINO_SMOKE_WALLET=your_public_wallet_address_here
KAMINO_REQUEST_TIMEOUT_MS=10000
KAMINO_MAX_SLOT_DRIFT=50
KAMINO_CACHE_TTL_MS=5000

# Jupiter Swap Quote Adapter Configuration (Phase 5C)
SWAP_QUOTE_SOURCE=demo
JUPITER_API_URL=https://api.jup.ag/swap/v2
# JUPITER_API_KEY=your_jupiter_api_key_here
JUPITER_REQUEST_TIMEOUT_MS=5000
JUPITER_MAX_RETRIES=2
JUPITER_QUOTE_TTL_SECS=15
