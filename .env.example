# LendRescue Monorepo Environment Configuration Baseline
# Copy to apps/api/.env or configure in deployment environments

# API Server Settings
BIND_HOST=127.0.0.1
BIND_PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT_SECS=30
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Telemetry & History (Optional; falls back to in-memory store)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lend_rescue

# Solana Cluster & RPC
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=surfpool

# Oracle Configuration (Phase 5A)
ORACLE_SOURCE=demo
PYTH_PROGRAM_ID=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
PYTH_MAX_AGE_SECS=60
PYTH_MAX_CONFIDENCE_RATIO_BPS=200
PYTH_REQUEST_TIMEOUT_MS=5000
HERMES_URL=https://hermes.pyth.network
# PYTH_API_KEY=your_pyth_api_key_here

