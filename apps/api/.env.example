SOLANA_NETWORK=surfpool
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# SURFPOOL_RPC_URL=http://127.0.0.1:8899

# Oracle Provider Selection: 'demo' | 'mock' | 'pyth'
ORACLE_SOURCE=demo

# Pyth Core Price Provider Configuration
PYTH_PROGRAM_ID=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
PYTH_MAX_AGE_SECS=60
PYTH_MAX_CONFIDENCE_RATIO_BPS=200
