# LendRescue API Configuration
BIND_HOST=127.0.0.1
BIND_PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT_SECS=30
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Cache & Telemetry Store (Optional in demo mode)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lend_rescue

# Solana Network & RPC Configuration
